# Copy to .env for local runs (.env is gitignored). In GitHub Actions these are
# provided as repository secrets instead.

# eBay developer app (production keyset) — https://developer.ebay.com
EBAY_CLIENT_ID=your-app-id
EBAY_CLIENT_SECRET=your-cert-id

# Neon pooled connection string — https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/dbname?sslmode=require

# Telegram bot — talk to @BotFather to create one, then message your bot once and
# read the chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
